{
  "name": "number-oasis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --experimental-strip-types --no-warnings scripts/validate-content.ts && node scripts/lint-i18n.mjs && tsc -b && vite build",
    "build:production": "node scripts/production-gate.mjs && npm run build",
    "preview": "vite preview --port 4173",
    "lint": "node scripts/lint-i18n.mjs && node scripts/lint-css.mjs && node --experimental-strip-types --no-warnings scripts/validate-content.ts && tsc -b && tsc -p e2e",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p e2e",
    "test:e2e": "playwright test --project=e2e --project=e2e-pixel7 --project=offline",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual",
    "lhci": "npm run build && lhci autorun && node scripts/lhci-js-budget.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/baloo-bhaijaan-2": "5.3.0",
    "@fontsource/cairo": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "dexie": "4.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.4",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.11"
  }
}
